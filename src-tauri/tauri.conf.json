{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Design Gravity",
  "version": "0.1.0",
  "identifier": "studio.designgravity.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Design Gravity",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#0F0E14",
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}